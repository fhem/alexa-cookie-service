{
  "name": "alexa-cookie-service",
  "version": "0.3.4",
  "description": "REST service and Docker wrapper around alexa-cookie for FHEM echodevice",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "healthcheck": "node scripts/healthcheck.js",
    "test": "prove -Ilib t && node --test test/*.test.js",
    "postinstall": "node scripts/patch-alexa-cookie2-refresh.js"
  },
  "dependencies": {
    "alexa-cookie2": "^5.0.3",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0"
  }
}
